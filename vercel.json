{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/pets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/academy", "destination": "/index.html" },
    { "source": "/academy/", "destination": "/index.html" },
    { "source": "/academy/index-vi.html", "destination": "/index-vi.html" },
    { "source": "/academy/api/:path*", "destination": "/api/:path*" },
    { "source": "/academy/pets/:path*", "destination": "/pets/:path*" },
    { "source": "/academy/fonts/:path*", "destination": "/fonts/:path*" },
    { "source": "/academy/codepet-wordmark.png", "destination": "/codepet-wordmark.png" },
    { "source": "/academy/astro-tran.jpg", "destination": "/astro-tran.jpg" }
  ]
}
